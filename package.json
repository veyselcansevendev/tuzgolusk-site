{
  "name": "eskil-tuzgolu-belediye-spor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:migrate": "node scripts/prepare-data.mjs && prisma migrate deploy",
    "db:deploy": "npm run db:migrate && prisma generate",
    "db:seed": "node --import tsx prisma/seed.ts",
    "admin:create": "node --import tsx scripts/bootstrap-admin.ts",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pages:export": "npm run build && node scripts/pages/export.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.0.0",
    "lucide-react": "^0.545.0",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.10.1",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "effect": "^3.22.5"
  }
}
