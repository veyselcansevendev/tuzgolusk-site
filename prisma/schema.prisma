  seoTitle String?
  seoDescription String?
  featured Boolean @default(false)
  backNewsTagNewsId NewsTag[] @relation("NewsTag_newsId")
  backNewsImageNewsId NewsImage[] @relation("NewsImage_newsId")
  backSocialPostNewsId SocialPost[] @relation("SocialPost_newsId")
  @@index([status, deletedAt, publishAt])
  @@index([position])
}

