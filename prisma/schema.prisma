  media Media @relation("DesignExport_mediaId", fields: [mediaId], references: [id], onDelete: Restrict)
  width Int
  height Int
  createdAt DateTime @default(now())
  @@index([designId, createdAt])
}

model SocialPost {
  id String @id @default(cuid())
  title String
  caption String
  hashtags String
  platform String
  state String @default("DRAFT")
  scheduledAt DateTime?
  matchId String?
  match Match? @relation("SocialPost_matchId", fields: [matchId], references: [id], onDelete: Restrict)
  newsId String?
  news News? @relation("SocialPost_newsId", fields: [newsId], references: [id], onDelete: Restrict)
  isTemplate Boolean @default(false)
  ownerId String
  owner User @relation("SocialPost_ownerId", fields: [ownerId], references: [id], onDelete: Restrict)
  version Int @default(1)
  publishedAt DateTime?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  backSocialAssetPostId SocialAsset[] @relation("SocialAsset_postId")
  @@index([state, scheduledAt])
}

model SocialAsset {
  id String @id @default(cuid())
  postId String
  post SocialPost @relation("SocialAsset_postId", fields: [postId], references: [id], onDelete: Restrict)
  mediaId String
  media Media @relation("SocialAsset_mediaId", fields: [mediaId], references: [id], onDelete: Restrict)
  @@unique([postId, mediaId])
}

model BackupRecord {
  id String @id @default(cuid())
  name String @unique
  bytes Int
  createdAt DateTime @default(now())
}
