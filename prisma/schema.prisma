generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Role {
  id String @id @default(cuid())
  key String @unique
  name String
  permissions Json
  backUserRoleId User[] @relation("User_roleId")
  backInviteRoleId Invite[] @relation("Invite_roleId")
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  active Boolean @default(true)
  roleId String
  role Role @relation("User_roleId", fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  backSessionUserId Session[] @relation("Session_userId")
  backAuditActorId Audit[] @relation("Audit_actorId")
  backRevisionActorId Revision[] @relation("Revision_actorId")
  backMediaUploaderId Media[] @relation("Media_uploaderId")
  backDesignOwnerId Design[] @relation("Design_ownerId")
  backDesignEditorId Design[] @relation("Design_editorId")
  backSocialPostOwnerId SocialPost[] @relation("SocialPost_ownerId")
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation("Session_userId", fields: [userId], references: [id], onDelete: Restrict)
  expiresAt DateTime
  @@index([expiresAt])
}

model Throttle {
  id String @id @default(cuid())
  key String @unique
  count Int
  resetAt DateTime
  @@index([resetAt])
}

model Invite {
  id String @id @default(cuid())
  tokenHash String @unique
  email String
  roleId String
  role Role @relation("Invite_roleId", fields: [roleId], references: [id], onDelete: Restrict)
  expiresAt DateTime
  usedAt DateTime?
}

model Audit {
  id String @id @default(cuid())
  actorId String?
  actor User? @relation("Audit_actorId", fields: [actorId], references: [id], onDelete: Restrict)
  module String
  action String
  recordId String?
  createdAt DateTime @default(now())
  @@index([module, createdAt])
  @@index([createdAt])
}

model Revision {
  id String @id @default(cuid())
  module String
  recordId String
  number Int
  snapshot Json
  actorId String
  actor User @relation("Revision_actorId", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@unique([module, recordId, number])
}

model Media {
  id String @id @default(cuid())
  key String @unique
  mimeType String @default("image/webp")
  sha256 String
  bytes Int
  width Int
  height Int
  alt String
  credit String
  small Boolean @default(false)
  isPublic Boolean @default(false)
  uploaderId String
  uploader User @relation("Media_uploaderId", fields: [uploaderId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  backNewsCoverId News[] @relation("News_coverId")
  backNewsImageMediaId NewsImage[] @relation("NewsImage_mediaId")
  backPageCoverId Page[] @relation("Page_coverId")
  backSlideCoverId Slide[] @relation("Slide_coverId")
  backSlideMobileId Slide[] @relation("Slide_mobileId")
  backTeamLogoId Team[] @relation("Team_logoId")
  backCompetitionLogoId Competition[] @relation("Competition_logoId")
  backOpponentLogoId Opponent[] @relation("Opponent_logoId")
  backStadiumCoverId Stadium[] @relation("Stadium_coverId")
  backPlayerPhotoId Player[] @relation("Player_photoId")
  backStaffPhotoId Staff[] @relation("Staff_photoId")
  backAlbumCoverId Album[] @relation("Album_coverId")
  backAlbumImageMediaId AlbumImage[] @relation("AlbumImage_mediaId")
  backVideoPosterId Video[] @relation("Video_posterId")
  backSponsorLogoId Sponsor[] @relation("Sponsor_logoId")
  backDesignMediaMediaId DesignMedia[] @relation("DesignMedia_mediaId")
  backDesignExportMediaId DesignExport[] @relation("DesignExport_mediaId")
  backSocialAssetMediaId SocialAsset[] @relation("SocialAsset_mediaId")
  @@index([createdAt])
}

model Category {
  id String @id @default(cuid())
  slug String @unique
  title String
  status String @default("DRAFT")
  publishAt DateTime?
  endAt DateTime?
  position Int @default(0)
  version Int @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
  kind String @default("NEWS")
  backNewsCategoryId News[] @relation("News_categoryId")
  backAlbumCategoryId Album[] @relation("Album_categoryId")
  backVideoCategoryId Video[] @relation("Video_categoryId")
  backSponsorCategoryId Sponsor[] @relation("Sponsor_categoryId")
  @@index([status, deletedAt, publishAt])
  @@index([position])
}

